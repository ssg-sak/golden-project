# OS 및 기타 IDE
Thumbs.db
.idea/

# =========================
# 문서 (Docs) - 화이트리스트 방식 (기본 비공개)
# =========================
# 1. docs 하위의 모든 항목을 기본적으로 숨김
docs/**
!docs/

# 2. 저장소에서 관리할 공개 문서와 이미지 허용
!docs/*.md
!docs/core/
!docs/core/*.md
!docs/reports/
!docs/reports/*.md
!docs/templates/
!docs/templates/*.md
!docs/plans/
!docs/plans/active/
!docs/plans/active/*.md
!docs/**/*.csv
!docs/images/
!docs/images/eda/
!docs/images/eda/*.png
!docs/images/citizen-map.png
!docs/images/golden-governance.png

