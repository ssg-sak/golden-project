# 카카오맵 JavaScript 키 — https://developers.kakao.com
# 플랫폼에 http://localhost:5173 등록
VITE_KAKAO_MAP_APP_KEY=

# 카카오 모빌리티 REST API 키 (백엔드용)
KAKAO_REST_API_KEY=

# 공공데이터포털 — 국립중앙의료원 응급의료기관 정보 조회 API
# https://www.data.go.kr/data/15000563/openapi.do
# 승인 후 마이페이지에서 키 복사 (디코딩 키 또는 URL 인코딩 키)
DATA_GO_KR_API_KEY=

# 실시간 병상 API
# - 승인 대기: true (Mock 병상)
# - 승인 완료: false + 위 DATA_GO_KR_API_KEY 설정 후 백엔드 재시작
USE_MOCK_API=true

# 연결 확인: python tests/integration/verify_realtime_api.py

# 실 API 모드: 백그라운드 병상 캐시 폴링 주기(초). 300~3600, 기본 600
# 중앙의료원 API별 일 1,000회 한도에서 정상 경로 약 144회/일이 되도록 600초 이상 권장
# BED_CACHE_POLL_INTERVAL_SEC=600

# FastAPI 백엔드 (병원 API)
VITE_API_BASE_URL=http://localhost:8000

# ==========================================
# Dynamic Dashboard & Automated Scheduler
# ==========================================
# 기존 정적 대시보드(false) vs 동적 대시보드(true)
VITE_USE_DYNAMIC_DASHBOARD_DATA=false

# 공공데이터 수집 스케줄러. 데이터 무결성 검증과 운영 로그 확인 전에는 false 유지.
# 운영 인구는 1~7일과 10·15·20·25일 18:00에 확인한다.
# 정책 분석 결과의 시험 실행·정식 반영은 GitHub Actions의 별도 월간 작업이 담당한다.
ENABLE_PUBLIC_DATA_SCHEDULER=false

# SGIS (행정구역 경계)
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=

# 수동 데이터 갱신을 위한 관리자 토큰. 비어 있으면 갱신 API는 503으로 비활성화됨.
DATA_REFRESH_ADMIN_TOKEN=

# 행정안전부 행정동별(통반단위) 주민등록 인구 API 활용신청 필요:
# https://www.data.go.kr/data/15108065/openapi.do
# 아래 값은 기본값과 동일하며, 제공기관 변경 시에만 재정의한다.
# POPULATION_API_BASE_URL=https://apis.data.go.kr/1741000/admmPpltnHhStus
# POPULATION_API_OPERATION=selectAdmmPpltnHhStus

# VDI용 연령별 인구는 행정안전부 주민등록 인구통계의 공식 CSV를 사용한다.
# 별도 키는 필요하지 않으며 총인구를 연령별로 추정하지 않는다.
# 확인: python -X utf8 backend/scripts/monthly_policy_release.py --mode check
# 시험 실행: python -X utf8 backend/scripts/monthly_policy_release.py --mode test --offline
# 정식 반영: python -X utf8 backend/scripts/monthly_policy_release.py --mode publish
# 큰 변화가 감지되면 변화 요약을 먼저 확인한 뒤 아래 옵션으로 다시 실행한다.
# 검토 완료: --confirm-reviewed-change

# 기준 시간대
APP_TIMEZONE=Asia/Seoul
